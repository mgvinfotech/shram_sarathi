{
  "expo": {
    "name": "Shram Sarathi",
    "slug": "shram-sarathi",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B00"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shramsarathi.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is needed to find nearby workers and service requests.",
        "NSCameraUsageDescription": "Camera is needed to take profile pictures and KYC document photos.",
        "NSPhotoLibraryUsageDescription": "Photo library access is needed to select profile pictures and KYC documents."
      }
    },
    "android": {
      "package": "com.shramsarathi.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Shram Sarathi to use your location to find nearby workers.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shram Sarathi to access photos for profile and KYC verification.",
          "cameraPermission": "Allow Shram Sarathi to use camera for profile and KYC verification."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "scheme": "shramsarathi",
    "extra": {
      "eas": {
        "projectId": "83e7f8ed-f0e2-4a7e-8add-0aa1635c68bb"
      }
    },
    "owner": "shivam_yadav_12"
  }
}
