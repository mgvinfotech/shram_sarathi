{
  "expo": {
    "name": "Shram Sarathi",
    "slug": "shram-sarathi",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B00"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shramsarathi.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is needed to find nearby Saarthis.",
        "NSLocationAlwaysUsageDescription": "Location is needed to find nearby Saarthis."
      }
    },
    "android": {
      "package": "com.shramsarathi.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Shram Sarathi to use your location to find nearby workers."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "scheme": "shramsarathi",
    "extra": {
      "eas": {
        "projectId": "83e7f8ed-f0e2-4a7e-8add-0aa1635c68bb"
      }
    }
  }
}
